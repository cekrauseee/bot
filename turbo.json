{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package-lock.json", "turbo.json", ".env", ".env.example", "apps/web/.env", "apps/web/.env.example", "apps/ai/.env"],
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "description": "Build a package and its internal dependencies",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "VITE_API_BASE_URL"],
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "RESEND_API_KEY", "RESEND_FROM", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
    },
    "lint": {
      "description": "Lint package source without producing artifacts",
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": []
    },
    "typecheck": {
      "description": "Type-check package source without emitting artifacts",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": []
    },
    "test": {
      "description": "Run deterministic unit tests",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": [],
      "env": ["NODE_ENV", "ENVIRONMENT", "DATABASE_URL", "NEON_WS_PROXY", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "GOOGLE_REDIRECT_URI", "TRUSTED_PROXY_HOSTS", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "SESSION_TTL_SECONDS", "OTP_TTL_SECONDS", "OTP_RESEND_COOLDOWN_SECONDS", "OTP_MAX_ATTEMPTS", "OTP_EMAIL_REQUESTS_PER_WINDOW", "OTP_IP_REQUESTS_PER_WINDOW", "OTP_VERIFY_ATTEMPTS_PER_IP_WINDOW", "OTP_RATE_LIMIT_WINDOW_SECONDS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY", "RESEND_FROM"],
      "passThroughEnv": []
    },
    "test:integration": {
      "description": "Run integration tests against external services",
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "env": ["ENVIRONMENT", "DATABASE_URL", "NEON_WS_PROXY", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "GOOGLE_REDIRECT_URI", "TRUSTED_PROXY_HOSTS", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "SESSION_TTL_SECONDS", "OTP_TTL_SECONDS", "OTP_RESEND_COOLDOWN_SECONDS", "OTP_MAX_ATTEMPTS", "OTP_EMAIL_REQUESTS_PER_WINDOW", "OTP_IP_REQUESTS_PER_WINDOW", "OTP_VERIFY_ATTEMPTS_PER_IP_WINDOW", "OTP_RATE_LIMIT_WINDOW_SECONDS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY", "RESEND_FROM"],
      "passThroughEnv": []
    },
    "dev": {
      "description": "Run a package development watcher or service",
      "cache": false,
      "persistent": true,
      "outputs": [],
      "env": ["ENVIRONMENT", "DATABASE_URL", "NEON_WS_PROXY", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "GOOGLE_REDIRECT_URI", "TRUSTED_PROXY_HOSTS", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY", "RESEND_FROM"]
    },
    "dev:preview": {
      "description": "Preview React Email templates",
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "db:generate": {
      "description": "Generate a Drizzle migration from the API schema",
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["ENVIRONMENT", "DATABASE_URL", "NEON_WS_PROXY", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "GOOGLE_REDIRECT_URI", "TRUSTED_PROXY_HOSTS", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY", "RESEND_FROM"]
    },
    "db:migrate": {
      "description": "Apply pending database migrations",
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["ENVIRONMENT", "DATABASE_URL", "NEON_WS_PROXY", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "GOOGLE_REDIRECT_URI", "TRUSTED_PROXY_HOSTS", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY", "RESEND_FROM"]
    },
    "db:check": {
      "description": "Check migration history and the database contract",
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["ENVIRONMENT", "DATABASE_URL", "NEON_WS_PROXY", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "GOOGLE_REDIRECT_URI", "TRUSTED_PROXY_HOSTS", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY", "RESEND_FROM"]
    },
    "//#scripts:lint": {
      "description": "Lint repository automation scripts",
      "inputs": ["scripts/**/*.mjs"],
      "outputs": []
    },
    "//#scripts:test": {
      "description": "Test repository automation scripts",
      "inputs": ["$TURBO_DEFAULT$", "!**/.turbo/**", "!**/dist/**", "!**/.venv/**", "!**/node_modules/**"],
      "outputs": []
    }
  }
}

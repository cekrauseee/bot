{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package-lock.json", "turbo.json", ".env", ".env.example"],
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "description": "Build a package and its internal dependencies",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "VITE_API_BASE_URL"]
    },
    "lint": {
      "description": "Lint package source without producing artifacts",
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": []
    },
    "typecheck": {
      "description": "Type-check package source without emitting artifacts",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": []
    },
    "test": {
      "description": "Run deterministic unit tests",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": [],
      "env": ["NODE_ENV", "ENVIRONMENT", "DATABASE_URL", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "VITE_API_BASE_URL", "AI_BASE_URL", "RUNTIME_BASE_URL", "RUNTIME_PORT", "RUNTIME_ENVIRONMENT", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "AI_SERVICE_TOKEN", "OPENAI_API_KEY", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "RESEND_API_KEY", "RESEND_FROM"],
      "passThroughEnv": ["RUNTIME_SERVICE_TOKEN", "XAI_API_KEY", "VERCEL_OIDC_TOKEN", "VERCEL_TOKEN", "VERCEL_TEAM_ID", "VERCEL_PROJECT_ID", "AGENT_BROWSER_SNAPSHOT_ID"]
    },
    "test:integration": {
      "description": "Run integration tests against external services",
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "env": ["ENVIRONMENT", "DATABASE_URL", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "VITE_API_BASE_URL", "AI_BASE_URL", "RUNTIME_BASE_URL", "RUNTIME_PORT", "RUNTIME_ENVIRONMENT", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "AI_SERVICE_TOKEN", "OPENAI_API_KEY", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "RESEND_API_KEY", "RESEND_FROM"],
      "passThroughEnv": ["RUNTIME_SERVICE_TOKEN", "XAI_API_KEY", "VERCEL_OIDC_TOKEN", "VERCEL_TOKEN", "VERCEL_TEAM_ID", "VERCEL_PROJECT_ID", "AGENT_BROWSER_SNAPSHOT_ID"]
    },
    "dev": {
      "description": "Run a package development watcher or service",
      "cache": false,
      "persistent": true,
      "outputs": [],
      "env": ["ENVIRONMENT", "DATABASE_URL", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "VITE_API_BASE_URL", "AI_BASE_URL", "RUNTIME_BASE_URL", "RUNTIME_PORT", "RUNTIME_ENVIRONMENT", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "AI_SERVICE_TOKEN", "OPENAI_API_KEY", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "RESEND_API_KEY", "RESEND_FROM"],
      "passThroughEnv": ["RUNTIME_SERVICE_TOKEN", "XAI_API_KEY", "VERCEL_OIDC_TOKEN", "VERCEL_TOKEN", "VERCEL_TEAM_ID", "VERCEL_PROJECT_ID", "AGENT_BROWSER_SNAPSHOT_ID"]
    },
    "dev:preview": {
      "description": "Preview React Email templates",
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "db:generate": {
      "description": "Generate a Drizzle migration from the API schema",
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["ENVIRONMENT", "DATABASE_URL", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "AI_BASE_URL", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "AI_SERVICE_TOKEN", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "RESEND_API_KEY", "RESEND_FROM"]
    },
    "db:migrate": {
      "description": "Apply pending database migrations",
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["ENVIRONMENT", "DATABASE_URL", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "AI_BASE_URL", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "AI_SERVICE_TOKEN", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "RESEND_API_KEY", "RESEND_FROM"]
    },
    "db:check": {
      "description": "Check migration history and the database contract",
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["ENVIRONMENT", "DATABASE_URL", "REDIS_URL", "WEB_BASE_URL", "API_BASE_URL", "AI_BASE_URL", "SESSION_SECRET", "OTP_PEPPER", "RATE_LIMIT_PEPPER", "AI_SERVICE_TOKEN", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "RESEND_API_KEY", "RESEND_FROM"]
    },
    "db:seed": {
      "description": "Seed complete local application conversations",
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["ENVIRONMENT", "DATABASE_URL", "MYBOT_SEED_USER_EMAIL"]
    },
    "//#scripts:lint": {
      "description": "Lint repository automation scripts",
      "inputs": ["scripts/**/*.mjs"],
      "outputs": []
    },
    "//#scripts:test": {
      "description": "Test repository automation scripts",
      "inputs": ["$TURBO_DEFAULT$", "!**/.turbo/**", "!**/dist/**", "!**/.venv/**", "!**/node_modules/**"],
      "outputs": []
    }
  }
}

{
  "name": "my-bot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/emails"
  ],
  "scripts": {
    "help": "node scripts/help.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run api:lint && npm run ai:lint && npm run scripts:lint && npm run web:lint && npm run emails:typecheck && npm run scripts:test && npm run emails:build && npm run api:test && npm run ai:test && npm run api:build && npm run web:build",
    "auth:check": "node scripts/check-auth.mjs",
    "db:generate": "npm run db:generate --workspace @my-bot/api",
    "db:migrate": "npm run db:migrate --workspace @my-bot/api",
    "db:check": "npm run db:check --workspace @my-bot/api",
    "infra:start": "node scripts/infra-start.mjs",
    "infra:stop": "docker compose down",
    "infra:reset": "docker compose down --volumes --remove-orphans && npm run infra:start",
    "api:dev": "npm run dev --workspace @my-bot/api",
    "api:lint": "npm run lint --workspace @my-bot/api",
    "api:test": "npm run test --workspace @my-bot/api",
    "api:test:integration": "npm run test:integration --workspace @my-bot/api",
    "api:build": "npm run build --workspace @my-bot/api",
    "ai:dev": "uv run --project apps/ai fastapi dev apps/ai/src/my_bot_ai/main.py --port 8001",
    "ai:lint": "uv run --project apps/ai ruff check apps/ai",
    "ai:test": "uv run --project apps/ai pytest apps/ai/tests",
    "web:dev": "npm run dev --workspace @my-bot/web",
    "web:lint": "npm run lint --workspace @my-bot/web",
    "web:build": "npm run build --workspace @my-bot/web",
    "emails:dev": "npm run dev --workspace @my-bot/emails",
    "emails:typecheck": "npm exec tsc --workspace @my-bot/emails -- --noEmit",
    "emails:build": "npm run build --workspace @my-bot/emails",
    "scripts:lint": "npm exec oxlint -- scripts",
    "scripts:test": "node --test scripts/tests/*.test.mjs"
  }
}

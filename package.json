{
  "name": "my-bot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "help": "node scripts/help.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "turbo run lint typecheck test build //#scripts:lint //#scripts:test",
    "auth:check": "node scripts/check-auth.mjs",
    "db:generate": "turbo run db:generate --filter=@my-bot/api",
    "db:migrate": "turbo run db:migrate --filter=@my-bot/api",
    "db:check": "turbo run db:check --filter=@my-bot/api",
    "infra:start": "node scripts/infra-start.mjs",
    "infra:stop": "docker compose down",
    "infra:reset": "docker compose down --volumes --remove-orphans && npm run infra:start",
    "api:dev": "turbo run dev --filter=@my-bot/api",
    "api:lint": "turbo run lint --filter=@my-bot/api",
    "api:typecheck": "turbo run typecheck --filter=@my-bot/api",
    "api:test": "turbo run test --filter=@my-bot/api",
    "api:test:integration": "turbo run test:integration --filter=@my-bot/api",
    "api:build": "turbo run build --filter=@my-bot/api",
    "ai:dev": "turbo run dev --filter=@my-bot/ai",
    "ai:lint": "turbo run lint --filter=@my-bot/ai",
    "ai:test": "turbo run test --filter=@my-bot/ai",
    "web:dev": "turbo run dev --filter=@my-bot/web",
    "web:lint": "turbo run lint --filter=@my-bot/web",
    "web:typecheck": "turbo run typecheck --filter=@my-bot/web",
    "web:build": "turbo run build --filter=@my-bot/web",
    "email:dev": "turbo run dev:preview --filter=@my-bot/email",
    "email:typecheck": "turbo run typecheck --filter=@my-bot/email",
    "email:build": "turbo run build --filter=@my-bot/email",
    "scripts:lint": "npm exec oxlint -- scripts",
    "scripts:test": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}

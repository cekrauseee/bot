{
  "name": "@my-bot/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:production": "node dist/db/migrate.js",
    "db:check:production": "node dist/db/check.js"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/node": "1.4.5",
    "@elysiajs/openapi": "1.4.15",
    "@my-bot/email": "0.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "bufferutil": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "ioredis": "6.0.0",
    "openid-client": "6.8.7",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "^19.2.8",
    "resend": "6.24.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "pg": "^8.23.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}

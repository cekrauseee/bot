{
  "name": "@my-bot/desktop",
  "productName": "myBot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "predev": "npm run icons:build --workspace=@my-bot/desktop && node scripts/build-public-config.mjs",
    "dev": "node scripts/dev.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "^24.13.3",
    "electron": "44.1.1",
    "node": "24.19.0",
    "sharp": "0.35.4",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "typescript": "~6.0.2"
  }
}

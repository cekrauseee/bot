# Runtime
# Required. Application mode: development, test, or production.
ENVIRONMENT=development

# Infrastructure
# Required. PostgreSQL URL; production accepts only Neon hosts (*.neon.tech).
DATABASE_URL=postgresql://mybot:mybot@localhost:5434/mybot
# Required. Redis connection URL using redis:// or rediss://.
REDIS_URL=redis://localhost:6380/0

# Service origins
# Required. Public web origin without a path, query, or credentials.
WEB_BASE_URL=http://localhost:5173
# Required. Public API origin without a path, query, or credentials.
API_BASE_URL=http://localhost:8000
# Optional. Browser-exposed API origin; local web and desktop default to port 8000.
VITE_API_BASE_URL=http://localhost:8000
# Required. Private FastAPI AI service origin.
AI_BASE_URL=http://localhost:8001
# Required. Private agent-runtime service origin.
RUNTIME_BASE_URL=http://localhost:8002
# Optional. Runtime listen port; defaults to 8002 when absent or invalid.
RUNTIME_PORT=8002
# Optional. Namespace for runtime-managed local and remote resources.
RUNTIME_ENVIRONMENT=development
# Optional. Execution provider: docker or vercel; production requires vercel.
RUNTIME_PROVIDER=docker

# Internal security
# Generated by npm run setup. Signs application state; unique and 32+ characters.
SESSION_SECRET=replace-with-a-unique-secret-at-least-32-characters
# Generated by npm run setup. Hashes OTP challenges; unique and 32+ characters.
OTP_PEPPER=replace-with-a-different-secret-at-least-32-characters
# Generated by npm run setup. Protects rate-limit identifiers; unique and 32+ characters.
RATE_LIMIT_PEPPER=replace-with-another-secret-at-least-32-characters
# Generated by npm run setup. Authenticates API requests to the AI service.
AI_SERVICE_TOKEN=replace-with-a-service-secret-at-least-32-characters
# Generated by npm run setup. Authenticates AI requests to the agent runtime.
RUNTIME_SERVICE_TOKEN=replace-with-a-runtime-secret-at-least-32-characters

# AI provider
# Optional. Required for real OpenAI requests and in production.
OPENAI_API_KEY=

# Codex subscription connection
# Optional. Codex executable name or path; defaults to codex.
CODEX_BINARY=codex
# Optional. ChatGPT authentication flow: browser or device.
CODEX_LOGIN_MODE=browser
# Optional. Uses a temporary local root; the production connection requires an absolute path.
CODEX_HOME_ROOT=

# Built-in GitHub connection and Remote MCP
# Optional. GitHub OAuth App client ID; provide it together with the client secret.
GITHUB_OAUTH_CLIENT_ID=
# Optional. GitHub OAuth App client secret; keep it server-side.
GITHUB_OAUTH_CLIENT_SECRET=
# Optional. OAuth callback; production requires HTTPS on the API origin.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Changing or losing this key requires every affected GitHub account to reconnect.
# Generated by npm run setup. Stable 32-byte standard-Base64 key for stored tokens.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Optional. Official GitHub Remote MCP HTTPS endpoint.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Vercel Sandbox
# Optional. Preferred Vercel OIDC credential for the runtime provider.
VERCEL_OIDC_TOKEN=
# Optional. Fallback access token; requires both team and project IDs.
VERCEL_TOKEN=
# Optional. Vercel team ID used with VERCEL_TOKEN.
VERCEL_TEAM_ID=
# Optional. Vercel project ID used with VERCEL_TOKEN.
VERCEL_PROJECT_ID=
# Optional. Prebuilt Sandbox snapshot that skips first-boot browser installation.
AGENT_BROWSER_SNAPSHOT_ID=

# Authentication providers
# Optional. Google OAuth client ID; required in production.
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
# Optional. Google OAuth client secret; required in production and kept server-side.
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Required. Google callback URL; production requires the API origin and HTTPS.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional. Resend API key for local UI work; required in production.
RESEND_API_KEY=re_example
# Required. Transactional sender name and email address.
RESEND_FROM="myBot <hello@example.com>"

# Database seed
# Optional. Target account email; defaults to the latest active local user.
MYBOT_SEED_USER_EMAIL=
